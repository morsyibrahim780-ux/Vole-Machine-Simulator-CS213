using namespace std;

class Memory {
private:
    string cells[256];
    Screen scr;
public:
    Memory() {
        for(int i = 0; i < 256; i++) {
            cells[i] = "00";
        }
    }

    void write(int address, string value) {
        if (address >= 0 && address < 256) {
            cells[address] = value;
            if (address == 255) {
                scr.show(value);
            }
        }
    }

    string read(int address) {
        if (address >= 0 && address < 256) {
            return cells[address];
        }
        return "00";
    }
};


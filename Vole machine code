using namespace std;

class Screen {
public:
    void show(string text) {
        cout << "Output: " << text << endl;
    }
};

class Memory {
private:
    string cells[256];
    Screen scr;
public:
    Memory() {
        for(int i = 0; i < 256; i++) {
            cells[i] = "00";
        }
    }

    void write(int address, string value) {
        if (address >= 0 && address < 256) {
            cells[address] = value;
            if (address == 255) {
                scr.show(value);
            }
        }
    }

    string read(int address) {
        if (address >= 0 && address < 256) {
            return cells[address];
        }
        return "00";
    }

    void clear() {
        for(int i = 0; i < 256; i++) {
            cells[i] = "00";
        }
    }
};

class RegisterFile {
private:
    unsigned char registers[16] = {0};
public:
    unsigned char get(int index) const {
        if (index >= 0 && index < 16) return registers[index];
        return 0;     
    }
    
    void set(int index, unsigned char value) {
        if (index >= 0 && index < 16) registers[index] = value;
    }
    
    void clear() {
        for (int i = 0; i < 16; i++) registers[i] = 0;
    }
    
    void display() const {
        cout << "registers Content" << endl;
        for (int i = 0; i < 16; i++) {
            cout << "R" << hex << uppercase << i << ":" << setw(2) << setfill('0') << (int)registers[i] << " ";
            if ((i + 1) % 4 == 0) cout << endl;
        }
        cout << dec << setfill(' ');
    }
};

class ALU {
public:
    unsigned char addInteger(unsigned char a, unsigned char b) const {
        return a + b;
    }
    
    unsigned char bitwiseAnd(unsigned char a, unsigned char b) const {
        return a & b;
    }
    
    unsigned char bitwiseOr(unsigned char a, unsigned char b) const {
        return a | b;
    }
    
    unsigned char bitwiseXor(unsigned char a, unsigned char b) const {
        return a ^ b;
    }
    
    unsigned char rotateRight(unsigned char value, unsigned char amount) const {
        amount %= 8;
        return (value >> amount) | (value << (8 - amount));
    }
    
    double decodeFloat(unsigned char val) const {
        int sign = (val & 0x80) ? -1 : 1;
        int exp = ((val >> 4) & 0x07) - 4;
        int mantissa = val & 0x0F;
        return sign * (mantissa / 16.0) * pow(2.0, exp);
    }
    
    unsigned char encodeFloat(double val) const {
        if (val == 0.0) return 0;
        unsigned char sign = (val < 0) ? 0x80 : 0;
        val = abs(val);
        int exp = 0;
        while (val >= 1.0 && exp < 3) { val /= 2.0; exp++; }
        while (val < 0.5 && exp > -4) { val *= 2.0; exp--; }
        int mantissa = (int)(val * 16.0 + 0.5);
        if (mantissa > 15) mantissa = 15;
        return sign | ((exp + 4) << 4) | mantissa;
    }
    
    unsigned char addFloat(unsigned char a, unsigned char b) const {
        return encodeFloat(decodeFloat(a) + decodeFloat(b));
    }
};

class ProgramLoader {
public:
    void loadProgramFromFile(Memory& mem, string filename) {
        ifstream file(filename);
        if (!file.is_open()) {
            cout << "Error opening file!" << endl;
            return;
        }
        string instruction;
        int address = 0;
        while (file >> instruction && address < 256) {
            mem.write(address, instruction);
            address++;
        }
        file.close();
        cout << "Program loaded successfully from file." << endl;
    }
};

class Simulator {
private:
    int pc; 
public:
    Simulator() : pc(0) {}

    void reset(int startAddress = 0) {
        pc = startAddress;
    }

    int getPC() const {
        return pc;
    }

    void step(Memory& mem, RegisterFile& regFile, ALU& alu) {
        if (pc < 0 || pc >= 255) return;
        
        string byte1_str = mem.read(pc);
        string byte2_str = mem.read(pc + 1);
        
        unsigned char op1 = stoi(byte1_str, nullptr, 16);
        unsigned char op2 = stoi(byte2_str, nullptr, 16);
        
        unsigned char opcode = (op1 >> 4) & 0x0F;
        unsigned char r = op1 & 0x0F;
        unsigned char xy = op2;
        unsigned char s = (op2 >> 4) & 0x0F;
        unsigned char t = op2 & 0x0F;
        unsigned char x = (op2 >> 4) & 0x0F;

        pc += 2;

        switch (opcode) {
            case 0x1: { 
                string val = mem.read(xy);
                regFile.set(r, stoi(val, nullptr, 16));
                break;
            }
            case 0x2: { 
                regFile.set(r, xy);
                break;
            }
            case 0x3: { 
                unsigned char val = regFile.get(r);
                stringstream ss;
                ss << hex << uppercase << setw(2) << setfill('0') << (int)val;
                mem.write(xy, ss.str());
                break;
            }
            case 0x4: { 
                regFile.set(r, regFile.get(s));
                break;
            }
            case 0x5: { 
                unsigned char valS = regFile.get(s);
                unsigned char valT = regFile.get(t);
                unsigned char res = alu.addInteger(valS, valT);
                regFile.set(r, res);
                break;
            }
            case 0x6: { 
                unsigned char valS = regFile.get(s);
                unsigned char valT = regFile.get(t);
                unsigned char res = alu.addFloat(valS, valT);
                regFile.set(r, res);
                break;
            }
            case 0x7: { 
                unsigned char valS = regFile.get(s);
                unsigned char valT = regFile.get(t);
                unsigned char res = alu.bitwiseOr(valS, valT);
                regFile.set(r, res);
                break;
            }
            case 0x8: { 
                unsigned char valS = regFile.get(s);
                unsigned char valT = regFile.get(t);
                unsigned char res = alu.bitwiseAnd(valS, valT);
                regFile.set(r, res);
                break;
            }
            case 0x9: { 
                unsigned char valS = regFile.get(s);
                unsigned char valT = regFile.get(t);
                unsigned char res = alu.bitwiseXor(valS, valT);
                regFile.set(r, res);
                break;
            }
            case 0xA: { 
                unsigned char val = regFile.get(r);
                unsigned char res = alu.rotateRight(val, x);
                regFile.set(r, res);
                break;
            }
            case 0xB: { 
                if (regFile.get(r) == regFile.get(0)) {
                    pc = xy;
                }
                break;
            }
            case 0xC: { 
                pc = 256; 
                cout << "Halt instruction executed." << endl;
                break;
            }
            default:
                break;
        }
    }

    void run(Memory& mem, RegisterFile& regFile, ALU& alu) {
        pc = 0;
        while (pc < 256) {
            string op1_str = mem.read(pc);
            unsigned char op1 = stoi(op1_str, nullptr, 16);
            unsigned char opcode = (op1 >> 4) & 0x0F;
            if (opcode == 0xC) {
                step(mem, regFile, alu);
                break;
            }
            step(mem, regFile, alu);
        }
    }
};

#endif